{
  "name": "atelier-produits",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:invoice": "npm run dev --workspace apps/invoice",
    "build:invoice": "npm run build --workspace apps/invoice",
    "dev:catalog": "npm run dev --workspace apps/catalog",
    "build:catalog": "npm run build --workspace apps/catalog",
    "dev:proposal": "npm run dev --workspace apps/proposal",
    "build:proposal": "npm run build --workspace apps/proposal",
    "dev:portal": "npm run dev --workspace apps/portal",
    "build:portal": "npm run build --workspace apps/portal",
    "genkey": "node tools/genkey.mjs",
    "test:e2e": "node tools/e2e-test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
